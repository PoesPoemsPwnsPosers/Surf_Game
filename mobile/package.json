{
  "name": "surf-game-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.25",
    "expo-keep-awake": "~58.0.4",
    "expo-screen-orientation": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "game": "npm --prefix .. install --no-audit --no-fund && npm --prefix .. run build:mobile",
    "start": "npm run game && expo start",
    "android": "npm run game && expo start --android",
    "ios": "npm run game && expo start --ios",
    "typecheck": "tsc --noEmit",
    "export": "npm run game && expo export --platform android --platform ios",
    "eas-build-post-install": "npm run game"
  },
  "private": true
}
